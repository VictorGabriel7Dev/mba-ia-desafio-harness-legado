# Modelo do .env da API. No fluxo normal você NÃO edita isto à mão:
# scripts/up.sh gera o api/.env desta cópia com portas, banco e pasta de anexos
# próprios (derivados do caminho da worktree), para duas cópias rodarem juntas.
# Os valores abaixo são só o padrão de desenvolvimento de uma cópia única.

# Banco desta cópia (o up.sh sobe um Postgres por cópia, em porta própria).
DATABASE_URL=postgresql://balcao:balcao@localhost:5432/balcao
DATABASE_URL_TEST=postgresql://balcao:balcao@localhost:5432/balcao_test

# Porta da API desta cópia.
PORT=4000

# Origem liberada no CORS: o front desta cópia.
WEB_ORIGIN=http://localhost:5173

# Modo da IA: "fake" é o padrão e NÃO usa chave real. "openai" exige OPENAI_API_KEY.
AI_MODE=fake
OPENAI_API_KEY=

# Pasta de anexos desta cópia (o up.sh aponta para .runtime/uploads da worktree).
UPLOAD_DIR=/tmp/balcao/uploads

# Intervalo do worker de triagem.
TRIAGE_INTERVAL_MS=2000

# Segredo do JWT.
JWT_SECRET=dev-secret
